PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mindvisiontech
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── Admin Panel ────────────────────────────────────────────────
# Required: sign JWT tokens for admin sessions
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# ── AWS S3 (PDF uploads) ────────────────────────────────────────
# Required for PDF upload/replace/delete to work
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
# Optional: CloudFront domain in front of the bucket (no https://, no trailing slash)
AWS_S3_BUCKET_DOMAIN=

# AWS credentials — prefer IAM role on EC2 (no keys needed), or set these for local dev:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=